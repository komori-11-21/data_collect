def load_data():
    all_files = glob.glob(os.path.join(DATA_DIR, "*.xls*"))
    standard_dfs = []

    if not all_files:
        st.warning(f"目录 {DATA_DIR} 下没有找到 Excel 文件。")
        return None

    for file_path in all_files:
        file_name = os.path.basename(file_path)

        try:
            df = pd.read_excel(file_path)
            df = normalize_columns(df)
        except Exception as e:
            st.warning(f"读取文件失败：{file_name}，原因：{e}")
            continue

        matched_config = match_config_by_filename(file_name)

        show_debug_file_info(file_name, df, matched_config)

        if not matched_config:
            st.warning(f"文件未匹配任何配置，已跳过：{file_name}")
            continue

        # app_detail 是钻取明细表，不进入主表
        if matched_config["type"] == "app_detail":
            continue

        p_keys = [k for k in JOIN_KEYS if k in df.columns]

        if not p_keys:
            st.warning(f"文件 {file_name} 缺少关联字段 id/data，已跳过。当前字段：{df.columns.tolist()}")
            continue

        order = TABLE_CONFIGS.index(matched_config)

        # ==========================
        # wide 类型
        # ==========================
        if matched_config["type"] == "wide":
            sub_df = df.copy()

            label = matched_config.get("label", "未命名指标")
            v_col = matched_config.get("val_col")
            t_col = matched_config.get("time_col")
            v_unit = matched_config.get("val_unit", "")
            t_unit = matched_config.get("time_unit", "")

            unit_suffix = make_unit_suffix(v_unit, t_unit)

            if not v_col or v_col not in sub_df.columns:
                st.warning(f"文件 {file_name} 缺少数值字段：{v_col}，已跳过该指标。")
                continue

            sub_df["指标分类"] = label + unit_suffix
            sub_df["数值"] = safe_pick_col(sub_df, v_col, "")
            sub_df["时长"] = safe_pick_col(sub_df, t_col, "")

            keep_cols = p_keys + ["指标分类", "时长", "数值"]
            sub_df = sub_df[keep_cols]
            sub_df["排序层级"] = order
            standard_dfs.append(sub_df)

        # ==========================
        # long 类型
        # ==========================
        elif matched_config["type"] == "long":
            item_col = matched_config.get("item_col")
            v_col = matched_config.get("val_col")
            t_col = matched_config.get("time_col")
            v_unit = matched_config.get("val_unit", "")
            t_unit = matched_config.get("time_unit", "")

            if not item_col or item_col not in df.columns:
                st.warning(f"文件 {file_name} 缺少分类字段：{item_col}，已跳过。")
                continue

            sub_df = df.copy()
            unit_suffix = make_unit_suffix(v_unit, t_unit)

            # longest_duration 去重逻辑
            if matched_config.get("dedup_rule") == "longest_duration":
                if t_col and t_col in sub_df.columns:
                    sub_df["duration_tmp"] = pd.to_numeric(sub_df[t_col], errors="coerce").fillna(0)
                    idx_max = sub_df.groupby(p_keys + [item_col])["duration_tmp"].idxmax()
                    sub_df = sub_df.loc[idx_max].copy()

                elif "发生时间" in sub_df.columns and "data" in sub_df.columns:
                    sub_df["发生时间"] = pd.to_datetime(sub_df["发生时间"], errors="coerce")
                    sub_df = sub_df.dropna(subset=["发生时间"])
                    sub_df = sub_df.sort_values(by=p_keys + [item_col, "发生时间"])

                    sub_df["next_time"] = sub_df.groupby(p_keys + [item_col])["发生时间"].shift(-1)
                    data_end = pd.to_datetime(sub_df["data"], errors="coerce") + pd.Timedelta(days=1) - pd.Timedelta(seconds=1)
                    sub_df["next_time"] = sub_df["next_time"].fillna(data_end)
                    sub_df["duration_tmp"] = (sub_df["next_time"] - sub_df["发生时间"]).dt.total_seconds()

                    idx_max = sub_df.groupby(p_keys + [item_col])["duration_tmp"].idxmax()
                    sub_df = sub_df.loc[idx_max].copy()

            sub_df["指标分类"] = " └─ " + sub_df[item_col].astype(str) + unit_suffix
            sub_df["数值"] = safe_pick_col(sub_df, v_col, "")
            sub_df["时长"] = safe_pick_col(sub_df, t_col, "")

            keep_cols = p_keys + ["指标分类", "时长", "数值"]
            sub_df = sub_df[keep_cols]
            sub_df["排序层级"] = order
            standard_dfs.append(sub_df)

        # ==========================
        # event 类型
        # ==========================
        elif matched_config["type"] == "event":
            item_col = matched_config.get("item_col")
            act_col = matched_config.get("action_col")

            if not item_col or item_col not in df.columns:
                st.warning(f"文件 {file_name} 缺少状态字段：{item_col}，已跳过。")
                continue

            if not act_col or act_col not in df.columns:
                st.warning(f"文件 {file_name} 缺少动作字段：{act_col}，已跳过。")
                continue

            sub_df = df.copy()

            if "发生时间" in sub_df.columns:
                sub_df["发生时间"] = pd.to_datetime(sub_df["发生时间"], errors="coerce")
                sub_df = sub_df.dropna(subset=["发生时间"])
                sub_df = sub_df.sort_values(by=p_keys + [item_col, "发生时间"])

                # 去掉连续重复动作
                sub_df["prev_act"] = sub_df.groupby(p_keys + [item_col])[act_col].shift(1)
                sub_df = sub_df[sub_df[act_col] != sub_df["prev_act"]].copy()

                time_str = sub_df["发生时间"].dt.strftime("%H:%M:%S")
                sub_df["轨迹点"] = "[" + time_str + "] " + sub_df[act_col].astype(str)

                agg_df = (
                    sub_df
                    .groupby(p_keys + [item_col])["轨迹点"]
                    .apply(lambda x: " ➜ ".join(x))
                    .reset_index()
                )
                agg_df["数值"] = agg_df["轨迹点"]

            else:
                agg_df = (
                    sub_df
                    .groupby(p_keys + [item_col])[act_col]
                    .apply(lambda x: " | ".join(x.astype(str).dropna().unique()))
                    .reset_index()
                )
                agg_df["数值"] = agg_df[act_col]

            agg_df["指标分类"] = " ⭐ " + agg_df[item_col].astype(str)
            agg_df["时长"] = ""
            agg_df["排序层级"] = order

            keep_cols = p_keys + ["指标分类", "时长", "数值", "排序层级"]
            standard_dfs.append(agg_df[keep_cols])

    if not standard_dfs:
        return None

    main_df = pd.concat(standard_dfs, ignore_index=True)

    sort_cols = [k for k in JOIN_KEYS if k in main_df.columns] + ["排序层级"]
    main_df = main_df.sort_values(by=sort_cols).reset_index(drop=True)

    return main_df


def load_app_detail_raw():
    """
    加载应用明细原始数据，不聚合，供钻取页面使用。
    """
    cfg = next((c for c in TABLE_CONFIGS if c.get("type") == "app_detail"), None)
    if not cfg:
        return None

    all_files = glob.glob(os.path.join(DATA_DIR, "*.xls*"))
    dfs = []

    for fp in all_files:
        file_name = os.path.basename(fp)
        matched_config = match_config_by_filename(file_name)

        if not matched_config or matched_config.get("type") != "app_detail":
            continue

        try:
            df = pd.read_excel(fp)
            df = normalize_columns(df)
            dfs.append(df)
        except Exception as e:
            st.warning(f"读取应用明细文件失败：{file_name}，原因：{e}")
            continue

    if dfs:
        return pd.concat(dfs, ignore_index=True)

    return None


