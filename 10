def normalize_columns(df):
    """
    把真实 Excel 字段统一改成程序内部字段：
    设备ID / 设备编号 / device_id -> id
    日期 / date / 统计日期 -> data
    """
    df.columns = df.columns.astype(str).str.strip()

    rename_map = {}

    for std_col, aliases in COLUMN_ALIASES.items():
        for col in df.columns:
            if col in aliases:
                rename_map[col] = std_col
                break

    df = df.rename(columns=rename_map)

    if "data" in df.columns:
        df["data"] = pd.to_datetime(df["data"], errors="coerce").dt.strftime("%Y-%m-%d")

    return df


def match_config_by_filename(file_name):
    """
    根据文件名匹配 TABLE_CONFIGS
    """
    file_name = file_name.lower()

    for cfg in TABLE_CONFIGS:
        keywords = cfg.get("keywords", [])
        if isinstance(keywords, str):
            keywords = [keywords]

        for kw in keywords:
            if str(kw).lower() in file_name:
                return cfg

    return None


def safe_pick_col(df, col_name, default=""):
    """
    安全取列。字段不存在时返回默认值，避免页面崩溃。
    """
    if col_name and col_name in df.columns:
        return df[col_name]
    return default


def make_unit_suffix(v_unit="", t_unit=""):
    if v_unit and t_unit:
        return f" ({v_unit} | {t_unit})"
    elif v_unit:
        return f" ({v_unit})"
    return ""


def hide_repeated(df_target, col_name):
    """
    连续相同值隐藏，用于表格视觉分组。
    """
    df_target = df_target.copy()
    if col_name in df_target.columns:
        s = df_target[col_name].copy()
        s[s == s.shift()] = ""
        df_target[col_name] = s
    return df_target


def show_debug_file_info(file_name, df, matched_config):
    """
    调试区：显示文件读取情况。
    """
    with st.expander(f"🧪 调试信息：{file_name}", expanded=False):
        st.write("识别到字段：", df.columns.tolist())
        st.write("匹配配置：", matched_config)


