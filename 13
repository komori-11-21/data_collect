# 🚀 智能列名标准化函数 (解决真实数据字段与系统代码不一致的问题)
# =====================================================================
def standardize_columns(df):
    """智能列名兼容映射函数"""
    # 强制去除列名前后的隐藏空格
    df.columns = df.columns.str.strip()
    
    rename_map = {}
    for col in df.columns:
        col_lower = str(col).lower()
        
        # 匹配你的各种 ID 字段，统一改为 'id' (在此处添加你实际使用的ID表头名)
        if col_lower in ['id', 'deviceid', 'device_id', '设备id', '设备编号', 'sn', 'uuid', 'mac']:
            rename_map[col] = 'id'
            
        # 匹配你的各种 Date 字段，统一改为代码底层的 'data' (在此处添加你实际使用的日期表头名)
        elif col_lower in ['date', 'data', '日期', '时间', '创建时间', '测试日期', 'test_date']:
            rename_map[col] = 'data'
            
    if rename_map:
        df.rename(columns=rename_map, inplace=True)
        
    return df

