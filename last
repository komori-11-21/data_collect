            clean_df['data'] = clean_df['采集时间'].dt.strftime('%Y-%m-%d')
            clean_df['小时'] = clean_df['采集时间'].dt.hour
            clean_df['状态'] = event_text.apply(
                lambda x: "摘下" if "摘" in str(x) or str(x).lower() in ["off", "remove", "removed"]
                else ("佩戴" if "佩" in str(x) or str(x).lower() in ["on", "wear", "worn"] else str(x))
            )
            clean_df = clean_df.dropna(subset=['采集时间'])
            if not clean_df.empty:
                dfs.append(clean_df)
        except Exception as e:
            st.error(f"🚨 解析摘戴详情表 [{os.path.basename(fp)}] 崩溃: {str(e)}")
            continue

    if dfs:
        return pd.concat(dfs, ignore_index=True).sort_values(['id', '采集时间']).reset_index(drop=True)
    return None


@st.cache_data(show_spinner=False)
def build_excel_bytes(df_source, config_dict):
    """按设备生成横向诊断报表。"""
    from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
    from openpyxl.utils import get_column_letter

    def clean_metric_name(value):
        text = str(value).strip()
        text = text.replace("└─", "").replace("⭐", "").strip()
        if " (" in text:
            text = text.split(" (", 1)[0].strip()
        return text

    def format_date_header(value):
        dt = pd.to_datetime(value, errors="coerce")
        if pd.isna(dt):
            return str(value)
        return f"{dt.year}/{dt.month}/{dt.day}"

    def format_sleep_date(value):
        dt = pd.to_datetime(value, errors="coerce")
        if pd.isna(dt):
            return str(value)
        return f"{dt.month}月{dt.day}日"

    def event_state(value):
        text = "" if pd.isna(value) else str(value)
        last_open = text.rfind("开")
        last_close = text.rfind("关")
        if last_open == -1 and last_close == -1:
            return text
        return "关" if last_close > last_open else "开"

    def first_value(df, metric, date_value, col_name):
        hit = df[(df["指标名称"] == metric) & (df["data"] == date_value)]
        if hit.empty or col_name not in hit.columns:
            return ""
        value = hit.iloc[0][col_name]
        return "" if pd.isna(value) else value

    def export_order_key(row):
        metric = row["指标名称"]
        priority = ["待机"] + [item for item in EXPORT_ITEM_ORDER if item != "待机"]
        if metric in priority:
            return (0, priority.index(metric), "")
        return (1, row["排序层级"], metric)

    out = io.BytesIO()
    has_data = False
    with pd.ExcelWriter(out, engine='openpyxl') as writer:
        sheet_name = '透视诊断结果'
        workbook = writer.book
        worksheet = workbook.create_sheet(sheet_name)
        writer.sheets[sheet_name] = worksheet
        current_row = 1

        thin_gray = Side(style="thin", color="D9D9D9")
        border = Border(left=thin_gray, right=thin_gray, top=thin_gray, bottom=thin_gray)
        header_fill = PatternFill("solid", fgColor="E2F0D9")
        center = Alignment(horizontal="center", vertical="center")
        left = Alignment(horizontal="left", vertical="center")
        right = Alignment(horizontal="right", vertical="center")

        for dev_id, sel_dates in config_dict.items():
            if sel_dates:
                chunk = df_source[(df_source["id"] == dev_id) & (df_source["data"].isin(sel_dates))]
                if not chunk.empty and 'data' in chunk.columns:
                    has_data = True
                    chunk = chunk.copy()
                    chunk["指标名称"] = chunk["指标分类"].apply(clean_metric_name)
                    dates = sorted(chunk["data"].dropna().unique().tolist(), key=lambda x: pd.to_datetime(x))

                    event_df = chunk[chunk["指标分类"].astype(str).str.contains("⭐", na=False)].copy()
                    sleep_df = chunk[chunk["指标名称"] == "休眠"].copy()
                    metric_df = chunk[
                        (~chunk["指标分类"].astype(str).str.contains("⭐", na=False)) &
                        (chunk["指标名称"] != "休眠")
                    ].copy()

                    metric_order = (
                        metric_df[["排序层级", "指标名称"]]
                        .drop_duplicates()
                    )
                    metric_order["导出排序"] = metric_order.apply(export_order_key, axis=1)
                    metric_order = metric_order.sort_values("导出排序")
                    metrics = metric_order["指标名称"].tolist()
                    row_count = max(len(metrics), len(dates), 1) + 1
                    start_row = current_row
                    end_row = start_row + row_count - 1

                    worksheet.cell(start_row, 1, "id")
                    worksheet.cell(start_row, 2, dev_id)

                    col = 3
                    for date_value in dates:
                        worksheet.merge_cells(start_row=start_row, start_column=col, end_row=start_row, end_column=col + 1)
                        worksheet.cell(start_row, col, format_date_header(date_value))
                        col += 2

                    event_names = (
                        event_df["指标名称"].dropna().drop_duplicates().tolist()
                        if not event_df.empty else []
                    )
                    event_start_col = col
                    for event_name in event_names:
                        worksheet.merge_cells(start_row=start_row, start_column=col, end_row=start_row, end_column=col + 1)
                        worksheet.cell(start_row, col, event_name)
                        for idx, date_value in enumerate(dates, start=start_row + 1):
                            worksheet.cell(idx, col, format_sleep_date(date_value))
                            value = first_value(event_df, event_name, date_value, "数值")
                            worksheet.cell(idx, col + 1, event_state(value) if value != "" else "")
                        col += 2

                    sleep_col = col
                    worksheet.cell(start_row, sleep_col, "休眠（次）")
                    for idx, date_value in enumerate(dates, start=start_row + 1):
                        worksheet.cell(idx, sleep_col, format_sleep_date(date_value))
                        worksheet.cell(idx, sleep_col + 1, first_value(sleep_df, "休眠", date_value, "数值"))

                    for idx, metric in enumerate(metrics, start=start_row + 1):
                        worksheet.cell(idx, 2, metric)
                        value_col = 3
                        for date_value in dates:
                            worksheet.cell(idx, value_col, first_value(metric_df, metric, date_value, "时长"))
                            worksheet.cell(idx, value_col + 1, first_value(metric_df, metric, date_value, "数值"))
                            value_col += 2

                    for row in worksheet.iter_rows(min_row=start_row, max_row=end_row, min_col=1, max_col=sleep_col + 1):
                        for cell in row:
                            cell.border = border
                            cell.alignment = right if isinstance(cell.value, (int, float)) else left
                            if cell.row == start_row:
                                cell.alignment = center if cell.column >= 3 else left
                                cell.font = Font(bold=False)

                    for col_idx in range(event_start_col, sleep_col):
                        worksheet.cell(start_row, col_idx).fill = header_fill
                        worksheet.cell(start_row + 1, col_idx).alignment = center
                    worksheet.cell(start_row, sleep_col).fill = header_fill

                    current_row = end_row + 2

        if not has_data:
            pd.DataFrame({"提示": ["暂无满足条件的数据"]}).to_excel(writer, index=False, sheet_name='空数据')
        else:
            worksheet.column_dimensions['A'].width = 18
            worksheet.column_dimensions['B'].width = 28
            for i in range(3, worksheet.max_column + 1):
                worksheet.column_dimensions[get_column_letter(i)].width = 16
    return out.getvalue()


