def standardize_columns(df):
    """智能列名兼容映射函数"""
    df.columns = df.columns.str.strip()
    rename_map = {}
    for col in df.columns:
        col_lower = str(col).lower()
        if col_lower in ['id', 'deviceid', 'device_id', '设备id', '设备编号', 'sn', 'uuid', 'mac']:
            rename_map[col] = 'id'
        elif col_lower in ['date', 'data', '日期', '时间', '创建时间', '测试日期', 'test_date']:
            rename_map[col] = 'data'
    if rename_map:
        df.rename(columns=rename_map, inplace=True)
    return df


def hide_repeated(df_target, col_name):
    """用于 UI 显示时的列去重掩码"""
    if col_name in df_target.columns:
        s = df_target[col_name].copy()
        s[s == s.shift()] = ""
        df_target[col_name] = s
    return df_target


def clean_display_metric(value):
    text = str(value).strip()
    text = text.replace("└─", "").replace("⭐", "").strip()
    if " (" in text:
        text = text.split(" (", 1)[0].strip()
    return text


def find_column(df, candidates):
    normalized = {str(c).strip().lower(): c for c in df.columns}
    for name in candidates:
        hit = normalized.get(str(name).strip().lower())
        if hit is not None:
            return hit
    return None


def build_timestamp(df, date_col, time_col):
    if date_col and time_col and date_col != time_col:
        return pd.to_datetime(
            df[date_col].astype(str).str.strip() + " " + df[time_col].astype(str).str.strip(),
            errors='coerce'
        )
    if time_col:
        return pd.to_datetime(df[time_col], errors='coerce')
    if date_col:
        return pd.to_datetime(df[date_col], errors='coerce')
    return pd.Series(pd.NaT, index=df.index)


def infer_event_state(value):
    text = "" if pd.isna(value) else str(value)
    last_open = text.rfind("开")
    last_close = text.rfind("关")
    if last_open == -1 and last_close == -1:
        return text
    return "关" if last_close > last_open else "开"


