                sleep_exit_plot_df = pd.DataFrame()
                wear_plot_df = pd.DataFrame()

                if sleep_exit_df is not None and not sleep_exit_df.empty and sel_date:
                    sleep_exit_plot_df = sleep_exit_df[sleep_exit_df['data'] == sel_date].copy()
                    if sel_dev and 'id' in sleep_exit_plot_df.columns:
                        sleep_exit_plot_df = sleep_exit_plot_df[sleep_exit_plot_df['id'] == sel_dev]
                    if not sleep_exit_plot_df.empty:
                        event_tabs.append("退出休眠")

                if wear_detail_df is not None and not wear_detail_df.empty and sel_date:
                    wear_plot_df = wear_detail_df[wear_detail_df['data'] == sel_date].copy()
                    if sel_dev and 'id' in wear_plot_df.columns:
                        wear_plot_df = wear_plot_df[wear_plot_df['id'] == sel_dev]
                    if not wear_plot_df.empty:
                        event_tabs.append("摘戴详情")

                if event_tabs:
                    st.markdown("### 🧭 当日事件分析")
                    tabs = st.tabs(event_tabs)
                    tab_index = 0

                    if not sleep_exit_plot_df.empty:
                        with tabs[tab_index]:
                            sleep_hour_df = (
                                sleep_exit_plot_df
                                .groupby(['小时', '原因'], as_index=False)['次数']
                                .sum()
                                .sort_values('小时')
                            )
                            fig_sleep_exit = px.bar(
                                sleep_hour_df,
                                x='小时',
                                y='次数',
                                color='原因',
                                title=f"{sel_dev} / {sel_date} 每小时退出休眠分布",
                                labels={'小时': '小时', '次数': '退出休眠次数', '原因': '原因'}
                            )
                            fig_sleep_exit.update_layout(height=340, barmode='stack', xaxis=dict(dtick=1))
                            st.plotly_chart(fig_sleep_exit, use_container_width=True)
                        tab_index += 1

                    if not wear_plot_df.empty:
                        with tabs[tab_index]:
                            fig_wear = px.scatter(
                                wear_plot_df,
                                x='采集时间',
                                y='状态',
                                color='状态',
                                title=f"{sel_dev} / {sel_date} 摘下与佩戴时间线",
                                labels={'采集时间': '时间', '状态': '状态'}
                            )
                            fig_wear.update_traces(marker=dict(size=11))
                            fig_wear.update_layout(height=300)
                            st.plotly_chart(fig_wear, use_container_width=True)

                if app_col in chart_df.columns and dur_col in chart_df.columns and pwr_col in chart_df.columns:
                    tree_df = chart_df[chart_df[dur_col] > 0]
                    if not tree_df.empty:
                        fig_tree = px.treemap(
                            tree_df, path=[app_col], values=dur_col, color=pwr_col,
                            title="🗺️ 应用消耗全景 (面积=时长, 颜色深浅=功耗)",
                            color_continuous_scale='YlOrRd'
                        )
                        fig_tree.update_layout(height=460)
                        st.plotly_chart(fig_tree, use_container_width=True)

                st.markdown("### 📝 运行明细记录")
                display_cols = [c for c in ['id', 'data', app_col, dur_col, pwr_col] if c in detail.columns]
                st.dataframe(detail[display_cols].reset_index(drop=True), use_container_width=True, height=400,
                             hide_index=True)
        else:
            st.warning("🚨 未检测到应用明细数据，请确认 data_source 目录中包含带 'app_detail' 关键字的 Excel 文件。")

else:
    # ================= 极端情况：完全无数据渲染诊断页 =================
    st.error("🚨 页面无法渲染，所有数据在校验环节被丢弃！请查看下方《数据流诊断报告》查找原因：")
    st.markdown("### 🩻 深度诊断日志")
    st.info("👇 展开下方每一个文件卡片，查看它的【原始列名】是怎样的，为什么它会被【状态：❌ 被丢弃】。")

    for log in debug_logs:
        if "文件名" in log:
            icon = "🟢" if "✅" in log.get("状态", "") else "🔴"
            with st.expander(f"{icon} 文件名: {log['文件名']} | 状态: {log.get('状态', '未知')}"):
                st.json(log)
        else:
            st.write(log)

    st.markdown("""
    ### 📝 常见排错建议
    1. **如果在【4_检出的核心合并键】里缺少 `id` 或 `data`**：
       说明你的真实设备名不叫 "id"，或者日期不叫 "data"。去代码顶部的 `standardize_columns()` 函数补充映射关系即可。
    2. **如果最后一步提示 `找不到 item_col / val_col`**：
       说明你在 `TABLE_CONFIGS` 配置的中文表头名称，在真实 Excel 表头里根本不存在（注意中英文冒号或多余空格）。
    """)
