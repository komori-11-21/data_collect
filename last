@st.cache_data(show_spinner=False)
def load_battery_detail_raw():
    all_files = glob.glob(os.path.join(DATA_DIR, "*.xls*"))
    dfs = []

    for fp in all_files:
        file_name = os.path.basename(fp).lower()
        if not any(keyword in file_name for keyword in BATTERY_FILE_KEYWORDS):
            continue

        try:
            df = pd.read_excel(fp)
            df.columns = df.columns.str.strip()

            id_col = find_column(df, ['id', 'deviceid', 'device_id', '设备id', '设备编号', 'sn', 'uuid', 'mac'])
            date_col = find_column(df, BATTERY_DATE_COLUMNS)
            time_col = find_column(df, BATTERY_TIME_COLUMNS)
            level_col = find_column(df, BATTERY_LEVEL_COLUMNS)

            if id_col and id_col != 'id':
                df.rename(columns={id_col: 'id'}, inplace=True)
            if not level_col:
                continue

            if date_col and time_col and date_col != time_col:
                timestamp = pd.to_datetime(
                    df[date_col].astype(str).str.strip() + " " + df[time_col].astype(str).str.strip(),
                    errors='coerce'
                )
            elif time_col:
                timestamp = pd.to_datetime(df[time_col], errors='coerce')
            elif date_col:
                timestamp = pd.to_datetime(df[date_col], errors='coerce')
            else:
                continue

            clean_df = pd.DataFrame()
            clean_df['id'] = df['id'] if 'id' in df.columns else ""
            clean_df['采集时间'] = timestamp
            clean_df['data'] = clean_df['采集时间'].dt.strftime('%Y-%m-%d')
            clean_df['电量'] = pd.to_numeric(
                df[level_col].astype(str).str.replace('%', '', regex=False).str.strip(),
                errors='coerce'
            )
            clean_df = clean_df.dropna(subset=['采集时间', '电量'])
            if not clean_df.empty:
                dfs.append(clean_df)
        except Exception as e:
            st.error(f"🚨 解析电量详情表 [{os.path.basename(fp)}] 崩溃: {str(e)}")
            continue

    if dfs:
        return pd.concat(dfs, ignore_index=True).sort_values(['id', '采集时间']).reset_index(drop=True)
    return None


@st.cache_data(show_spinner=False)
def load_sleep_exit_raw():
    all_files = glob.glob(os.path.join(DATA_DIR, "*.xls*"))
    dfs = []

    for fp in all_files:
        file_name = os.path.basename(fp).lower()
        if not any(keyword in file_name for keyword in SLEEP_EXIT_FILE_KEYWORDS):
            continue

        try:
            df = pd.read_excel(fp)
            df.columns = df.columns.str.strip()

            id_col = find_column(df, ['id', 'deviceid', 'device_id', '设备id', '设备编号', 'sn', 'uuid', 'mac'])
            date_col = find_column(df, BATTERY_DATE_COLUMNS)
            time_col = find_column(df, BATTERY_TIME_COLUMNS)
            hour_col = find_column(df, HOUR_COLUMNS)
            count_col = find_column(df, SLEEP_EXIT_COUNT_COLUMNS)
            reason_col = find_column(df, SLEEP_EXIT_REASON_COLUMNS)

            if id_col and id_col != 'id':
                df.rename(columns={id_col: 'id'}, inplace=True)

            timestamp = build_timestamp(df, date_col, time_col)

            clean_df = pd.DataFrame()
            clean_df['id'] = df['id'] if 'id' in df.columns else ""
            clean_df['采集时间'] = timestamp
            if date_col:
                clean_df['data'] = pd.to_datetime(df[date_col], errors='coerce').dt.strftime('%Y-%m-%d')
            else:
                clean_df['data'] = clean_df['采集时间'].dt.strftime('%Y-%m-%d')

            if hour_col:
                hour_text = df[hour_col].astype(str).str.extract(r'(\d{1,2})', expand=False)
                clean_df['小时'] = pd.to_numeric(hour_text, errors='coerce')
            else:
                clean_df['小时'] = clean_df['采集时间'].dt.hour

            if count_col:
                clean_df['次数'] = pd.to_numeric(df[count_col], errors='coerce').fillna(0)
            else:
                clean_df['次数'] = 1

            clean_df['原因'] = df[reason_col].astype(str).str.strip() if reason_col else "全部"
            clean_df = clean_df.dropna(subset=['data', '小时'])
            clean_df = clean_df[(clean_df['小时'] >= 0) & (clean_df['小时'] <= 23)]
            if not clean_df.empty:
                clean_df['小时'] = clean_df['小时'].astype(int)
                dfs.append(clean_df)
        except Exception as e:
            st.error(f"🚨 解析退出休眠表 [{os.path.basename(fp)}] 崩溃: {str(e)}")
            continue

    if dfs:
        result = pd.concat(dfs, ignore_index=True).sort_values(['id', 'data', '小时']).reset_index(drop=True)
        has_reason = result['原因'].ne("全部").groupby([result['id'], result['data'], result['小时']]).transform('any')
        result = result[~(has_reason & result['原因'].eq("全部"))]
        return result.reset_index(drop=True)
    return None


